    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.0.0",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "lucide-react": "^0.294.0",
    "next": "^16.3.0",
    "react": "^18",
    "react-dom": "^18",
